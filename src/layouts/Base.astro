---
import { getMenu, getEmDashCollection, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(await getSiteSettings());
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// Fetch primary menu defined in seed
const menu = await getMenu("primary");

// Optional "social" menu
const socialMenu = await getMenu("social");

// Fetch pages for footer
const { entries: pages } = await getEmDashCollection("pages");

// Build public page context for plugin contributions
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<div class="header-inner">
				<a href="/" class="site-logo">
					{siteLogo
						? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="logo-img" />
						: <div class="logo-placeholder" aria-hidden="true"></div>
					}
					<div class="wordmark">
						<small>Scouting</small>
						<span>Regio Lek- en IJsselstreek</span>
					</div>
				</a>
				<button class="menu-toggle" aria-label="Menu openen" aria-expanded="false" aria-controls="site-nav">
					<span class="burger-bar"></span>
					<span class="burger-bar"></span>
					<span class="burger-bar"></span>
				</button>
				<nav class="site-nav" id="site-nav" aria-label="Hoofdnavigatie">
					{
						menu?.items.map((item) => (
							<a href={item.url} target={item.target} class="nav-link">
								{item.label}
							</a>
						))
					}
					<a href="/posts" class="kalender-btn">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
							<rect x="3" y="5" width="18" height="16" rx="2"/>
							<path d="M3 9h18M8 3v4M16 3v4"/>
						</svg>
						Nieuws
					</a>
					{isLoggedIn && (
						<a href="/_emdash/admin" class="nav-admin">Admin</a>
					)}
					<div class="header-search">
						<LiveSearch
							placeholder="Zoeken…"
							class="site-search"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages"]}
						/>
					</div>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="ftr-inner">
				<div class="ftr-grid">
					<div class="ftr-brand-col">
						<div class="ftr-brand">
							{siteLogo
								? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="ftr-logo-img" />
								: <div class="ftr-logo-placeholder" aria-hidden="true"></div>
							}
							<div>
								<h4 class="ftr-brand-name">{siteTitle}</h4>
								<p class="ftr-brand-desc">{siteTagline}</p>
							</div>
						</div>
					</div>
					<div class="ftr-nav-col">
						<h4 class="ftr-heading">Ontdek</h4>
						<ul class="ftr-links">
							<li><a href="/">Home</a></li>
							{pages.slice(0, 3).map((page) => (
								<li>
									<a href={`/pages/${page.data.slug || page.id}`}>
										{page.data.title}
									</a>
								</li>
							))}
						</ul>
					</div>
					<div class="ftr-nav-col">
						<h4 class="ftr-heading">Doe mee</h4>
						<ul class="ftr-links">
							<li><a href="/posts">Nieuws</a></li>
							{socialMenu?.items.map((item) => (
								<li>
									<a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>
										{item.label}
									</a>
								</li>
							))}
							<li><a href="/rss.xml">RSS Feed</a></li>
						</ul>
					</div>
					<div class="ftr-nav-col">
						<WidgetArea name="footer" />
					</div>
					<div class="ftr-newsletter-col">
						<h4 class="ftr-heading">Op de hoogte blijven</h4>
						<p class="ftr-newsletter-desc">Maandelijkse update met activiteiten, trainingen en nieuws uit de regio.</p>
						<form class="ftr-newsletter-form" action="#" method="post">
							<input type="email" placeholder="je@email.nl" class="ftr-email-input" aria-label="E-mailadres" />
							<button type="submit" class="ftr-subscribe-btn">Inschrijven</button>
						</form>
					</div>
				</div>
				<div class="ftr-bottom">
					<p class="ftr-copyright">© 2026 Scouting Regio Lek- en IJsselstreek · Onderdeel van <a href="https://www.scouting.nl">Scouting Nederland</a></p>
					<div class="ftr-socials">
						<a href="#" aria-label="Facebook" class="ftr-social-link">
							<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
								<path d="M13 22v-8h3l1-4h-4V7c0-1.2.4-2 2.2-2H17V1.5C16.6 1.4 15.4 1.3 14 1.3c-3 0-5 1.8-5 5V10H6v4h3v8h4z"/>
							</svg>
						</a>
						<a href="#" aria-label="Instagram" class="ftr-social-link">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
								<rect x="3" y="3" width="18" height="18" rx="5"/>
								<circle cx="12" cy="12" r="4"/>
								<circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
							</svg>
						</a>
						<a href="#" aria-label="YouTube" class="ftr-social-link">
							<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
								<path d="M22 12s0-3.5-.4-5.2c-.3-1-1-1.7-2-2C17.5 4.5 12 4.5 12 4.5s-5.5 0-7.6.3c-1 .3-1.7 1-2 2C2 8.5 2 12 2 12s0 3.5.4 5.2c.3 1 1 1.7 2 2 2 .3 7.6.3 7.6.3s5.5 0 7.6-.3c1-.3 1.7-1 2-2C22 15.5 22 12 22 12zM10 15.5v-7l6 3.5-6 3.5z"/>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</footer>


		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				:root {
					/* Colors - Light mode (default) */
					--color-bg: #ffffff;
					--color-bg-subtle: #F6F6F4;
					--color-text: #2A2A2A;
					--color-text-secondary: #5C5C5C;
					--color-muted: #5C5C5C;
					--color-border: #E6E6E2;
					--color-border-subtle: #F0F0EC;
					--color-surface: #F6F6F4;
					--color-accent: #28B0E6;
					--color-accent-hover: #1B8FBF;
					--color-on-accent: white;
					--color-accent-ring: color-mix(
						in srgb,
						var(--color-accent) 25%,
						transparent
					);

					/* EmDash search theming */
					--emdash-search-bg: var(--color-bg);
					--emdash-search-text: var(--color-text);
					--emdash-search-muted: var(--color-muted);
					--emdash-search-border: var(--color-border);
					--emdash-search-hover: var(--color-surface);
					--emdash-search-highlight: var(--color-text);

					/* Type scale */
					--font-size-xs: 0.8125rem;
					--font-size-sm: 0.875rem;
					--font-size-base: 1rem;
					--font-size-lg: 1.125rem;
					--font-size-xl: 1.25rem;
					--font-size-2xl: 1.5rem;
					--font-size-3xl: 2rem;
					--font-size-4xl: 2.5rem;
					--font-size-5xl: 3.5rem;

					/* Line heights */
					--leading-tight: 1.1;
					--leading-snug: 1.25;
					--leading-normal: 1.5;
					--leading-relaxed: 1.65;

					/* Spacing */
					--spacing-1: 0.25rem;
					--spacing-2: 0.5rem;
					--spacing-3: 0.75rem;
					--spacing-4: 1rem;
					--spacing-5: 1.25rem;
					--spacing-6: 1.5rem;
					--spacing-8: 2rem;
					--spacing-10: 2.5rem;
					--spacing-12: 3rem;
					--spacing-16: 4rem;
					--spacing-20: 5rem;
					--spacing-24: 6rem;

					/* Legacy spacing aliases */
					--spacing-xs: var(--spacing-1);
					--spacing-sm: var(--spacing-2);
					--spacing-md: var(--spacing-4);
					--spacing-lg: var(--spacing-6);
					--spacing-xl: var(--spacing-8);
					--spacing-2xl: var(--spacing-12);
					--spacing-3xl: var(--spacing-16);

					/* Layout */
					--content-width: 680px;
					--wide-width: 1200px;
					--max-width: var(--content-width);
					--gutter-width: 200px;
					--nav-height: 90px;

					/* Transitions */
					--transition-fast: 120ms ease;
					--transition-base: 180ms ease;

					/* Search */
					--search-input-width: 180px;

					/* Article layout */
					--meta-col-width: 180px;

					/* Avatar sizes */
					--avatar-size-xs: 18px;
					--avatar-size-sm: 20px;
					--avatar-size-md: 24px;
					--avatar-size-lg: 32px;

					/* Letter spacing */
					--tracking-tight: -0.03em;
					--tracking-snug: -0.02em;
					--tracking-wide: 0.06em;
					--tracking-wider: 0.08em;

					/* Tag pill */
					--tag-padding-y: 4px;

					/* Shadows */
					--shadow-dropdown: 0 8px 30px rgba(0, 0, 0, 0.12);
					--shadow-btn-active: 0 1px 2px rgba(0, 0, 0, 0.05);
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-sans);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-accent);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-accent-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-display, var(--font-sans));
					line-height: var(--leading-tight);
					font-weight: 800;
				}

				h1 { letter-spacing: var(--tracking-tight); }
				h2, h3 { letter-spacing: var(--tracking-snug); }

				::selection {
					background: var(--color-primary);
					color: white;
				}
			}
		</style>

		<style>
			/* ── Header ──────────────────────────────────────────────── */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: var(--color-primary);
			}

			.header-inner {
				display: flex;
				align-items: center;
				gap: 20px;
				max-width: 1240px;
				margin: 0 auto;
				padding: 16px 32px;
				height: var(--nav-height);
			}

			.site-logo {
				display: flex;
				align-items: center;
				gap: 12px;
				text-decoration: none;
				flex-shrink: 0;
			}

			.site-logo:hover { text-decoration: none; }

			.logo-img {
				width: 56px;
				height: 56px;
				border-radius: var(--radius-pill);
				background: #fff;
				box-shadow: var(--shadow-card);
				padding: 3px;
				object-fit: contain;
			}

			.logo-placeholder {
				width: 56px;
				height: 56px;
				border-radius: var(--radius-pill);
				background: rgba(255,255,255,.2);
				flex-shrink: 0;
			}

			.wordmark {
				display: flex;
				flex-direction: column;
				line-height: 1.1;
				font-weight: 900;
				color: #fff;
				font-family: var(--font-display, var(--font-sans));
			}

			.wordmark small {
				font-size: 10px;
				font-weight: 700;
				letter-spacing: .14em;
				text-transform: uppercase;
				opacity: .85;
			}

			.wordmark span { font-size: 17px; }

			.site-nav {
				margin-left: auto;
				display: flex;
				align-items: center;
				gap: 4px;
				flex-wrap: wrap;
			}

			.nav-link {
				display: inline-flex;
				align-items: center;
				padding: 9px 14px;
				border-radius: var(--radius-pill);
				color: #fff;
				font-size: var(--font-size-xs);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: .06em;
				text-decoration: none;
				transition: background var(--transition-fast);
			}

			.nav-link:hover {
				background: rgba(255,255,255,.16);
				color: #fff;
				text-decoration: none;
			}

			.kalender-btn {
				display: inline-flex;
				align-items: center;
				gap: 7px;
				padding: 10px 20px;
				border-radius: var(--radius-pill);
				background: #fff;
				color: var(--color-primary-hover);
				font-size: var(--font-size-xs);
				font-weight: 800;
				letter-spacing: .08em;
				text-transform: uppercase;
				text-decoration: none;
				margin-left: 8px;
				box-shadow: 0 4px 12px rgba(0,0,0,.06);
				transition: transform var(--transition-fast), box-shadow var(--transition-fast);
			}

			.kalender-btn:hover {
				transform: translateY(-1px);
				box-shadow: var(--shadow-card);
				color: var(--color-primary-hover);
				text-decoration: none;
			}

			.nav-admin {
				font-size: var(--font-size-xs);
				color: rgba(255,255,255,.7);
				text-decoration: none;
				background: rgba(255,255,255,.12);
				padding: 6px 12px;
				border-radius: var(--radius-pill);
				margin-left: 4px;
				transition: background var(--transition-fast);
			}

			.nav-admin:hover {
				background: rgba(255,255,255,.22);
				color: #ffffff;
			}

			/* Search */
			.header-search {
				position: relative;
				flex-shrink: 0;
				margin-left: auto;
			}

			:global(.site-search-input) {
				width: 160px;
				padding: 8px 14px;
				font-family: var(--font-sans);
				font-size: var(--font-size-sm);
				border: 1px solid rgba(255,255,255,.35);
				border-radius: var(--radius-pill);
				background: rgba(255,255,255,.15);
				color: #fff;
				/* prevent browser from overriding with a white autofill background */
				-webkit-box-shadow: 0 0 0 1000px rgba(255,255,255,.15) inset;
				-webkit-text-fill-color: #fff;
				transition: border-color var(--transition-fast), background var(--transition-fast);
			}

			:global(.site-search-input)::placeholder { color: rgba(255,255,255,.6); }

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				background: rgba(255,255,255,.22);
				-webkit-box-shadow: 0 0 0 1000px rgba(255,255,255,.22) inset;
				border-color: rgba(255,255,255,.8) !important;
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				right: 0;
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				box-shadow: var(--shadow-dropdown);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
				min-width: 280px;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child { border-bottom: none; }

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 600;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}

			main {
				min-height: calc(100vh - var(--nav-height) - 400px);
			}

			/* ── Footer ──────────────────────────────────────────────── */
			.site-footer {
				background: var(--color-primary-dark);
				color: rgba(255,255,255,.8);
			}

			.ftr-inner {
				max-width: 1240px;
				margin: 0 auto;
				padding: 80px 32px 24px;
			}

			.ftr-grid {
				display: grid;
				grid-template-columns: 1.8fr 1fr 1fr 1fr 1.5fr;
				gap: 48px;
				margin-bottom: 56px;
			}

			.ftr-brand {
				display: flex;
				align-items: flex-start;
				gap: 14px;
			}

			.ftr-logo-img {
				width: 48px;
				height: 48px;
				border-radius: var(--radius-pill);
				background: rgba(255,255,255,.1);
				padding: 3px;
				object-fit: contain;
				flex-shrink: 0;
			}

			.ftr-logo-placeholder {
				width: 48px;
				height: 48px;
				border-radius: var(--radius-pill);
				background: rgba(255,255,255,.12);
				flex-shrink: 0;
			}

			.ftr-brand-name {
				font-size: 15px;
				font-weight: 800;
				color: #fff;
				letter-spacing: 0;
				text-transform: none;
				margin-bottom: 6px;
			}

			.ftr-brand-desc {
				font-size: var(--font-size-sm);
				color: rgba(255,255,255,.65);
				line-height: 1.55;
				margin: 0;
			}

			.ftr-heading {
				font-size: var(--font-size-xs);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: rgba(255,255,255,.5);
				margin-bottom: var(--spacing-4);
			}

			.ftr-links {
				list-style: none;
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2);
			}

			.ftr-links a {
				color: rgba(255,255,255,.75);
				text-decoration: none;
				font-size: var(--font-size-sm);
				transition: color var(--transition-fast);
			}

			.ftr-links a:hover { color: #fff; }

			.ftr-newsletter-desc {
				font-size: var(--font-size-sm);
				color: rgba(255,255,255,.65);
				line-height: 1.55;
				margin-bottom: var(--spacing-3);
			}

			.ftr-newsletter-form {
				display: flex;
				flex-direction: column;
				gap: var(--spacing-2);
			}

			.ftr-email-input {
				padding: 10px 16px;
				border-radius: var(--radius-pill);
				border: 1px solid rgba(255,255,255,.2);
				background: rgba(255,255,255,.08);
				color: #fff;
				font-size: var(--font-size-sm);
				font-family: var(--font-sans);
				transition: border-color var(--transition-fast), background var(--transition-fast);
			}

			.ftr-email-input::placeholder { color: rgba(255,255,255,.45); }
			.ftr-email-input:focus {
				outline: none;
				border-color: rgba(255,255,255,.5);
				background: rgba(255,255,255,.12);
			}

			.ftr-subscribe-btn {
				padding: 10px 20px;
				border-radius: var(--radius-pill);
				background: var(--color-primary);
				color: #fff;
				font-size: var(--font-size-sm);
				font-weight: 700;
				font-family: var(--font-sans);
				text-transform: uppercase;
				letter-spacing: .06em;
				border: none;
				cursor: pointer;
				transition: background var(--transition-fast);
			}

			.ftr-subscribe-btn:hover { background: var(--color-primary-hover); }

			/* Widget area in footer */
			.ftr-nav-col :global(.widget-area) { display: block; }
			.ftr-nav-col :global(.widget__title) {
				font-size: var(--font-size-xs);
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: var(--tracking-wider);
				color: rgba(255,255,255,.5);
				margin-bottom: var(--spacing-4);
			}
			.ftr-nav-col :global(.widget__content) {
				color: rgba(255,255,255,.75);
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
			}

			.ftr-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: var(--spacing-6);
				border-top: 1px solid rgba(255,255,255,.12);
			}

			.ftr-copyright {
				font-size: var(--font-size-sm);
				color: rgba(255,255,255,.45);
				margin: 0;
			}

			.ftr-copyright a { color: rgba(255,255,255,.65); }
			.ftr-copyright a:hover { color: #fff; }

			.ftr-socials {
				display: flex;
				gap: var(--spacing-3);
			}

			.ftr-social-link {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 34px;
				height: 34px;
				border-radius: var(--radius-pill);
				background: rgba(255,255,255,.1);
				color: rgba(255,255,255,.7);
				text-decoration: none;
				transition: background var(--transition-fast), color var(--transition-fast);
			}

			.ftr-social-link:hover {
				background: rgba(255,255,255,.2);
				color: #fff;
			}

			/* ── Responsive ──────────────────────────────────────────── */
			@media (max-width: 1100px) {
				.ftr-grid {
					grid-template-columns: 1fr 1fr 1fr;
					gap: var(--spacing-8);
				}
				.ftr-brand-col { grid-column: span 3; }
				.ftr-newsletter-col { grid-column: span 3; }
			}

			/* Hamburger button — hidden on desktop */
			.menu-toggle {
				display: none;
				flex-direction: column;
				justify-content: center;
				gap: 5px;
				width: 40px;
				height: 40px;
				padding: 8px;
				background: rgba(255,255,255,.15);
				border: none;
				border-radius: var(--radius-pill);
				cursor: pointer;
				margin-left: auto;
				flex-shrink: 0;
			}

			.burger-bar {
				display: block;
				width: 100%;
				height: 2px;
				background: #fff;
				border-radius: 2px;
				transition: transform var(--transition-base), opacity var(--transition-base);
				transform-origin: center;
			}

			.menu-toggle[aria-expanded="true"] .burger-bar:nth-child(1) {
				transform: translateY(7px) rotate(45deg);
			}
			.menu-toggle[aria-expanded="true"] .burger-bar:nth-child(2) {
				opacity: 0;
				transform: scaleX(0);
			}
			.menu-toggle[aria-expanded="true"] .burger-bar:nth-child(3) {
				transform: translateY(-7px) rotate(-45deg);
			}

			@media (max-width: 860px) {
				.wordmark span { font-size: 14px; }
				.site-nav { gap: 2px; }
				.nav-link { padding: 8px 10px; font-size: 11px; }
			}

			@media (max-width: 720px) {
				.header-inner {
					height: auto;
					padding: 12px 20px;
					flex-wrap: nowrap;
				}

				.menu-toggle { display: flex; }

				/* Nav hidden by default on mobile, shown when open */
				.site-nav {
					display: none;
					position: absolute;
					top: 100%;
					left: 0;
					right: 0;
					z-index: 200;
					background: var(--color-primary);
					padding: 12px 20px 20px;
					flex-direction: column;
					gap: 4px;
					box-shadow: 0 8px 24px rgba(0,0,0,.15);
				}

				.site-nav.is-open {
					display: flex;
				}

				.site-header { position: sticky; top: 0; }

				.nav-link {
					padding: 12px 16px;
					font-size: var(--font-size-sm);
					border-radius: var(--radius);
					width: 100%;
				}

				.kalender-btn {
					margin-left: 0;
					margin-top: 4px;
					justify-content: center;
				}

				/* Search inside dropdown on mobile: full width, top margin separator */
				.header-search {
					margin-left: 0;
					margin-top: 8px;
					width: 100%;
					padding-top: 12px;
					border-top: 1px solid rgba(255,255,255,.15);
				}

:global(.site-search-input) {
				width: 100%;
				border-radius: var(--radius);
				background: rgba(255,255,255,.35);
				color: #fff;
				border: 2px solid rgba(255,255,255,.5);
				-webkit-box-shadow: 0 0 0 1000px rgba(255,255,255,.35) inset;
				-webkit-text-fill-color: #fff;
				-moz-appearance: none;
				-webkit-appearance: none;
				appearance: none;
			}

			:global(.site-search-input)::placeholder {
				color: rgba(255,255,255,.85) !important;
				-webkit-text-fill-color: rgba(255,255,255,.85);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				background: rgba(255,255,255,.4);
				-webkit-box-shadow: 0 0 0 1000px rgba(255,255,255,.4) inset;
				border-color: rgba(255,255,255,.9);
			}

				:global(.site-search-results) {
					right: auto;
					left: 0;
					width: 100%;
					min-width: 0;
				}

				.ftr-grid {
					grid-template-columns: 1fr 1fr;
					gap: var(--spacing-8);
				}

				.ftr-brand-col { grid-column: span 2; }
				.ftr-newsletter-col { grid-column: span 2; }
			}

			@media (max-width: 480px) {
				.ftr-grid { grid-template-columns: 1fr; }
				.ftr-brand-col { grid-column: span 1; }
				.ftr-newsletter-col { grid-column: span 1; }
				.ftr-bottom {
					flex-direction: column;
					gap: var(--spacing-4);
					text-align: center;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input"
					) as HTMLInputElement;
					if (searchInput) searchInput.focus();
				}
			});

			// Hamburger menu toggle
			const toggle = document.querySelector(".menu-toggle") as HTMLButtonElement | null;
			const nav = document.getElementById("site-nav");
			if (toggle && nav) {
				toggle.addEventListener("click", () => {
					const open = toggle.getAttribute("aria-expanded") === "true";
					toggle.setAttribute("aria-expanded", String(!open));
					toggle.setAttribute("aria-label", open ? "Menu openen" : "Menu sluiten");
					nav.classList.toggle("is-open", !open);
				});

				// Close on outside click
				document.addEventListener("click", (e) => {
					if (
						nav.classList.contains("is-open") &&
						!nav.contains(e.target as Node) &&
						!toggle.contains(e.target as Node)
					) {
						toggle.setAttribute("aria-expanded", "false");
						toggle.setAttribute("aria-label", "Menu openen");
						nav.classList.remove("is-open");
					}
				});
			}
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
