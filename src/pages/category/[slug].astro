---
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("category", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={`${term.label}`} description={`Berichten in de categorie ${term.label}`}>
	<section class="page-hero">
		<div class="hero-blobs" aria-hidden="true">
			<svg viewBox="0 0 1440 460" preserveAspectRatio="none">
				<path d="M0,0 L1440,0 L1440,340 C1180,440 720,340 480,400 C240,460 120,400 0,440 Z"
					  fill="#A8D58A"/>
			</svg>
		</div>
		<div class="hero-container">
			<nav class="breadcrumb" aria-label="Broodkruimels">
				<a href="/">Home</a>
				<span class="sep" aria-hidden="true">/</span>
				<a href="/posts">Nieuws</a>
				<span class="sep" aria-hidden="true">/</span>
				<span aria-current="page">{term.label}</span>
			</nav>
			<p class="archive-label">Categorie</p>
			<h1>{term.label}</h1>
			<p class="hero-lede">
				{filteredPosts.length} {filteredPosts.length === 1 ? "bericht" : "berichten"}
			</p>
		</div>
	</section>

	<section class="archive-section">
		<div class="container">
			{
				filteredPosts.length === 0 ? (
					<p class="no-posts">Nog geen berichten in deze categorie.</p>
				) : (
					<div class="posts-grid">
						{filteredPosts.map(({ post, tags }) => (
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={`/posts/${post.id}`}
								date={post.data.publishedAt ?? undefined}
								readingTime={getReadingTime(post.data.content)}
								tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							/>
						))}
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.page-hero {
		position: relative;
		background: var(--color-primary);
		overflow: hidden;
		isolation: isolate;
	}

	.hero-blobs {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-blobs svg { width: 100%; height: 100%; display: block; }

	.hero-container {
		position: relative;
		z-index: 1;
		max-width: 1240px;
		margin: 0 auto;
		padding: 56px 32px 80px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 20px;
		font-size: var(--font-size-sm);
	}

	.breadcrumb a {
		color: rgba(255,255,255,.85);
		text-decoration: none;
		font-weight: 600;
	}

	.breadcrumb a:hover { color: #fff; }
	.breadcrumb .sep { color: rgba(255,255,255,.5); }
	.breadcrumb span:last-child { color: #fff; font-weight: 700; }

	.archive-label {
		font-size: 12px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: .08em;
		color: rgba(255,255,255,.75);
		margin-bottom: 8px;
		display: block;
	}

	.page-hero h1 {
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: 900;
		color: #fff;
		letter-spacing: -.02em;
		margin-bottom: 10px;
	}

	.hero-lede {
		font-size: 16px;
		color: rgba(255,255,255,.8);
		margin: 0;
	}

	.archive-section {
		padding: 56px 0 96px;
	}

	.container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.no-posts {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	@media (max-width: 900px) {
		.posts-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 600px) {
		.hero-container { padding: 40px 20px 60px; }
		.container { padding: 0 20px; }
		.posts-grid { grid-template-columns: 1fr; }
	}
</style>
