---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

const { entries: vacatures, cacheHint } = await getEmDashCollection("vacatures", {
	orderBy: { created_at: "desc" },
});

Astro.cache.set(cacheHint);

const iconTypeMap: Record<string, string> = {
	training: "training",
	kamp: "kamp",
	bestuur: "bestuur",
};

function getIconType(iconType: string | undefined): string {
	if (!iconType) return "bestuur";
	return iconTypeMap[iconType] ?? "bestuur";
}
---

<Base title="Vacatures" description="Open vacatures binnen Scouting Regio Lek- en IJsselstreek — van bestuur tot trainer tot kamphulp.">
	<!-- ── Page hero ──────────────────────────────────────────────── -->
	<section class="page-hero">
		<div class="hero-blobs" aria-hidden="true">
			<svg viewBox="0 0 1440 460" preserveAspectRatio="none">
				<path d="M0,0 L1440,0 L1440,340 C1180,440 720,340 480,400 C240,460 120,400 0,440 Z"
					  fill="var(--color-primary)"/>
			</svg>
		</div>
		<div class="hero-container">
			<nav class="breadcrumb" aria-label="Broodkruimels">
				<a href="/">Home</a>
				<span class="sep" aria-hidden="true">/</span>
				<span aria-current="page">Vacatures</span>
			</nav>
			<h1>Vacatures</h1>
			<p class="hero-lede">
				Op zoek naar een plek voor jouw inzet? De regio heeft altijd ruimte voor
				enthousiaste mensen — van bestuur tot trainer tot kamphulp.
			</p>
		</div>
	</section>

	<!-- ── Vacatures ─────────────────────────────────────────────── -->
	<section class="vacatures-section">
		<div class="container">
			{vacatures.length === 0 ? (
				<p class="empty">Er zijn momenteel geen openstaande vacatures.</p>
			) : (
				<div class="vacature-grid">
					{vacatures.map((vacature) => (
						<a class="vacature-card" href={`/vacatures/${vacature.id}`}>
							<div class="vacature-header">
								<div class="vacature-icon">
									{getIconType(vacature.data.icon_type) === "training" ? (
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11v5c2 2 10 2 12 0v-5M22 9v5"/></svg>
									) : getIconType(vacature.data.icon_type) === "kamp" ? (
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><path d="M3 21l9-16 9 16H3zM12 21V11"/></svg>
									) : (
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/></svg>
									)}
								</div>
								<div>
									<div class="vacature-org">{vacature.data.organization}</div>
									<div class="vacature-commit">{vacature.data.commitment}</div>
								</div>
							</div>
							<h3 class="vacature-role">{vacature.data.role}</h3>
							<p class="vacature-desc">{vacature.data.description}</p>
							<span class="vacature-link">
								Bekijk vacature
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
							</span>
						</a>
					))}
				</div>
			)}
		</div>
	</section>
</Base>

<style>
	/* ── Page hero ───────────────────────────────────────────────── */
	.page-hero {
		position: relative;
		background: #A8D58A;
		overflow: hidden;
		isolation: isolate;
	}

	.hero-blobs {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-blobs svg { width: 100%; height: 100%; display: block; }

	.hero-container {
		position: relative;
		z-index: 1;
		max-width: 1240px;
		margin: 0 auto;
		padding: 56px 32px 80px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 20px;
		font-size: var(--font-size-sm);
	}

	.breadcrumb a {
		color: rgba(255,255,255,.85);
		text-decoration: none;
		font-weight: 600;
	}

	.breadcrumb a:hover { color: #fff; }

	.breadcrumb .sep { color: rgba(255,255,255,.5); }

	.breadcrumb span:last-child { color: #fff; font-weight: 700; }

	.page-hero h1 {
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: 900;
		color: #fff;
		letter-spacing: -.02em;
		margin-bottom: 14px;
	}

	.hero-lede {
		font-size: 17px;
		line-height: 1.6;
		color: rgba(255,255,255,.9);
		max-width: 60ch;
		margin: 0;
	}

	/* ── Vacatures section ────────────────────────────────────────── */
	.vacatures-section {
		padding: 56px 0 96px;
	}

	.container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	/* ── Vacature grid ───────────────────────────────────────────── */
	.vacature-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	/* ── Vacature card ───────────────────────────────────────────── */
	.vacature-card {
		background: #fff;
		border-radius: var(--radius-xl);
		padding: 28px;
		box-shadow: var(--shadow-card);
		display: flex;
		flex-direction: column;
		gap: 14px;
		text-decoration: none;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		transition: transform var(--transition-base), box-shadow var(--transition-base);
	}

	.vacature-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-card-hover);
		text-decoration: none;
		color: var(--color-text);
	}

	.vacature-header {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.vacature-icon {
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background: #DDF1FA;
		color: var(--color-accent-hover);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.vacature-org {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: .08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.vacature-commit {
		font-size: 12px;
		color: var(--color-muted);
		margin-top: 2px;
	}

	.vacature-role {
		font-size: 19px;
		font-weight: 800;
		line-height: 1.25;
		margin: 0;
	}

	.vacature-desc {
		font-size: 14px;
		color: var(--color-muted);
		line-height: 1.55;
		margin: 0;
		flex: 1;
	}

	.vacature-link {
		font-size: 13px;
		font-weight: 800;
		color: var(--color-primary-hover);
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 6px;
	}

	/* ── Responsive ──────────────────────────────────────────────── */
	@media (max-width: 900px) {
		.vacature-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 600px) {
		.hero-container { padding: 40px 20px 60px; }
		.container { padding: 0 20px; }
		.vacature-grid { grid-template-columns: 1fr; }
	}
</style>