---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});

Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label })),
}));

const featured = postsWithTags[0];
const rest = postsWithTags.slice(1);

const formatDate = (date: Date) =>
	date.toLocaleDateString("nl-NL", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
---

<Base title="Nieuws" description="Updates over groepen, bestuur, trainingen en activiteiten — alles wat er speelt tussen Lek en IJssel.">
	<!-- ── Page hero ──────────────────────────────────────────────── -->
	<section class="page-hero">
		<div class="hero-blobs" aria-hidden="true">
			<svg viewBox="0 0 1440 460" preserveAspectRatio="none">
				<path d="M0,0 L1440,0 L1440,340 C1180,440 720,340 480,400 C240,460 120,400 0,440 Z"
					  fill="#A8D58A"/>
			</svg>
		</div>
		<div class="hero-container">
			<nav class="breadcrumb" aria-label="Broodkruimels">
				<a href="/">Home</a>
				<span class="sep" aria-hidden="true">/</span>
				<span aria-current="page">Nieuws</span>
			</nav>
			<h1>Nieuws uit de regio</h1>
			<p class="hero-lede">
				Updates over groepen, bestuur, trainingen en activiteiten — alles wat er
				speelt tussen Lek en IJssel.
			</p>
		</div>
	</section>

	<!-- ── Posts ─────────────────────────────────────────────────── -->
	<section class="posts-section">
		<div class="container">
			{posts.length === 0 ? (
				<p class="empty">Er zijn nog geen berichten gepubliceerd.</p>
			) : (
				<>
					{/* Featured — first/largest post */}
					{featured && (
						<a href={`/posts/${featured.post.id}`} class="featured-card">
							<div class="featured-image">
								{featured.post.data.featured_image ? (
									<Image image={featured.post.data.featured_image} />
								) : (
									<div class="featured-placeholder" aria-hidden="true">
										<svg viewBox="0 0 640 400" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
											<rect width="640" height="400" fill="#DCEFE5"/>
											<circle cx="200" cy="220" r="112" fill="#5BAE3A" opacity=".22"/>
											<circle cx="480" cy="160" r="64" fill="#28B0E6" opacity=".25"/>
										</svg>
									</div>
								)}
							</div>
							<div class="featured-body">
								<span class="featured-badge">
									<span aria-hidden="true">★</span> Uitgelicht
									{featured.tags[0] && <> · {featured.tags[0].label}</>}
								</span>
								<h2 class="featured-title">{featured.post.data.title}</h2>
								{featured.post.data.excerpt && (
									<p class="featured-excerpt">{featured.post.data.excerpt}</p>
								)}
								<div class="featured-meta">
									{featured.post.data.publishedAt && (
										<span>{formatDate(featured.post.data.publishedAt)}</span>
									)}
									<span>·</span>
									<span>{getReadingTime(featured.post.data.content)} min leestijd</span>
								</div>
								<span class="featured-cta">
									Lees verder
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
								</span>
							</div>
						</a>
					)}

					{/* Rest in 3-column grid */}
					{rest.length > 0 && (
						<div class="news-grid">
							{rest.map(({ post, tags }) => (
								<PostCard
									title={post.data.title ?? "Zonder titel"}
									excerpt={post.data.excerpt}
									featuredImage={post.data.featured_image}
									href={`/posts/${post.id}`}
									date={post.data.publishedAt ?? undefined}
									readingTime={getReadingTime(post.data.content)}
									tags={tags}
								/>
							))}
						</div>
					)}
				</>
			)}
		</div>
	</section>
</Base>

<style>
	/* ── Page hero ───────────────────────────────────────────────── */
	.page-hero {
		position: relative;
		background: var(--color-primary);
		overflow: hidden;
		isolation: isolate;
	}

	.hero-blobs {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-blobs svg { width: 100%; height: 100%; display: block; }

	.hero-container {
		position: relative;
		z-index: 1;
		max-width: 1240px;
		margin: 0 auto;
		padding: 56px 32px 80px;
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 20px;
		font-size: var(--font-size-sm);
	}

	.breadcrumb a {
		color: rgba(255,255,255,.85);
		text-decoration: none;
		font-weight: 600;
	}

	.breadcrumb a:hover { color: #fff; }

	.breadcrumb .sep { color: rgba(255,255,255,.5); }

	.breadcrumb span:last-child { color: #fff; font-weight: 700; }

	.page-hero h1 {
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: 900;
		color: #fff;
		letter-spacing: -.02em;
		margin-bottom: 14px;
	}

	.hero-lede {
		font-size: 17px;
		line-height: 1.6;
		color: rgba(255,255,255,.9);
		max-width: 60ch;
		margin: 0;
	}

	/* ── Posts section ───────────────────────────────────────────── */
	.posts-section {
		padding: 56px 0 96px;
	}

	.container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 32px;
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	/* ── Featured card ───────────────────────────────────────────── */
	.featured-card {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		background: #fff;
		border-radius: var(--radius-xl);
		overflow: hidden;
		box-shadow: var(--shadow-card);
		text-decoration: none;
		color: inherit;
		margin-bottom: 32px;
		border: 1px solid var(--color-border);
		transition: box-shadow var(--transition-base);
	}

	.featured-card:hover {
		box-shadow: var(--shadow-card-hover);
		text-decoration: none;
		color: inherit;
	}

	.featured-image {
		min-height: 320px;
		overflow: hidden;
		background: var(--color-surface);
	}

	.featured-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.featured-card:hover .featured-image img { transform: scale(1.04); }

	.featured-placeholder { width: 100%; height: 100%; }

	.featured-body {
		padding: 40px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.featured-badge {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: #FFE9DB;
		color: #C04300;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: .08em;
		text-transform: uppercase;
		width: max-content;
		margin-bottom: 14px;
	}

	.featured-title {
		font-size: clamp(1.4rem, 2.2vw, 1.9rem);
		font-weight: 900;
		line-height: 1.2;
		margin-bottom: 12px;
		transition: color var(--transition-fast);
	}

	.featured-card:hover .featured-title { color: var(--color-primary); }

	.featured-excerpt {
		font-size: 16px;
		line-height: 1.6;
		color: var(--color-muted);
		margin-bottom: 18px;
	}

	.featured-meta {
		display: flex;
		gap: 10px;
		font-size: 13px;
		color: var(--color-muted);
		margin-bottom: 20px;
	}

	.featured-cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 800;
		color: var(--color-primary-hover);
	}

	/* ── News grid ───────────────────────────────────────────────── */
	.news-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	/* ── Responsive ──────────────────────────────────────────────── */
	@media (max-width: 900px) {
		.featured-card { grid-template-columns: 1fr; }
		.featured-image { min-height: 240px; }
		.featured-body { padding: 28px; }
		.news-grid { grid-template-columns: repeat(2, 1fr); }
	}

	@media (max-width: 600px) {
		.hero-container { padding: 40px 20px 60px; }
		.container { padding: 0 20px; }
		.news-grid { grid-template-columns: 1fr; }
	}
</style>
