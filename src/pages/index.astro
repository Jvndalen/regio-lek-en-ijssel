---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 3,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag"
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title={siteTitle} description={siteTagline}>
	<!-- ── Hero blob ─────────────────────────────────────────────── -->
	<section class="hero">
		<div class="hero-blobs" aria-hidden="true">
			<svg viewBox="0 0 1440 760" preserveAspectRatio="none">
				<path d="M0,0 L1440,0 L1440,540 C1180,680 920,520 680,620 C420,720 200,540 0,640 Z"
					  fill="#A8D58A"/>
				<path d="M0,0 L1440,0 L1440,460 C1160,600 900,460 660,560 C400,660 200,500 0,580 Z"
					  fill="#5BAE3A"/>
			</svg>
		</div>
		<div class="hero-dot hero-dot--w hero-dot--main" style="top:8%;right:-3%;width:220px;height:220px;" aria-hidden="true"></div>
		<div class="hero-dot hero-dot--n" style="top:40%;right:-2%;width:60px;height:60px;" aria-hidden="true"></div>
		<div class="hero-dot hero-dot--b" style="top:62%;right:-4%;width:140px;height:140px;" aria-hidden="true"></div>
		<div class="hero-dot hero-dot--w" style="top:24%;left:4%;width:36px;height:36px;opacity:.35" aria-hidden="true"></div>
		<div class="hero-inner">
			<h1>Tussen <em>Lek</em> en <em>IJssel</em>.<br/>Land en water, samen scouten.</h1>
			<p class="hero-sub">
				Scouting Regio Lek- en IJsselstreek bestaat uit 16 groepen — acht op het land,
				acht op het water. Hier vind je activiteiten, trainingen en alles wat er speelt.
			</p>
			<div class="hero-cta">
				<a href="/posts" class="btn btn-light">Lees het nieuws</a>
				<a href="#nieuws" class="btn btn-ghost">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
						<rect x="3" y="5" width="18" height="16" rx="2"/>
						<path d="M3 9h18M8 3v4M16 3v4"/>
					</svg>
					Laatste nieuws
				</a>
			</div>
		</div>
	</section>

	<!-- ── Quick tiles ───────────────────────────────────────────── -->
	<div class="quick-tiles">
		<a class="quick-tile quick-tile--featured" href="/posts">
			<span class="qt-badge">Nieuw</span>
			<span class="qt-arrow" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M7 17L17 7M7 7h10v10"/></svg>
			</span>
			<div class="qt-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
			</div>
			<h3>Activiteiten</h3>
			<p class="qt-meta">Hemelvaartsontmoeting, regiospelen, kampweekenden — alles in de agenda.</p>
		</a>
		<a class="quick-tile" href="/posts" style="--qt-accent:#28B0E6">
			<span class="qt-arrow" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M7 17L17 7M7 7h10v10"/></svg>
			</span>
			<div class="qt-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/></svg>
			</div>
			<h3>Vacatures</h3>
			<p class="qt-meta">Bestuur, trainers, regiokamp — op zoek naar de leukste plek voor jouw inzet.</p>
		</a>
		<a class="quick-tile" href="/posts" style="--qt-accent:#1F3D7A">
			<span class="qt-arrow" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M7 17L17 7M7 7h10v10"/></svg>
			</span>
			<div class="qt-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11v5c2 2 10 2 12 0v-5M22 9v5"/></svg>
			</div>
			<h3>Trainingen</h3>
			<p class="qt-meta">Scouting Academy: van basistraining tot teamleiderschap. Nieuwe ronde voorjaar.</p>
		</a>
		<a class="quick-tile" href="/posts" style="--qt-accent:#5BAE3A">
			<span class="qt-arrow" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M7 17L17 7M7 7h10v10"/></svg>
			</span>
			<div class="qt-icon">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2 21c0-3.5 3-6 7-6s7 2.5 7 6M17 11a3 3 0 0 0 0-6M22 21c0-3-2-5-5-5"/></svg>
			</div>
			<h3>Groepen</h3>
			<p class="qt-meta">16 groepen tussen Lek en IJssel — vind er een bij jou in de buurt.</p>
		</a>
	</div>

	<!-- ── Agenda ────────────────────────────────────────────────── -->
	<section class="section-agenda" id="agenda">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Agenda</p>
					<h2 class="section-title">Wat staat er op de planning?</h2>
					<p class="section-lede">
						Hier vind je alle aankomende activiteiten binnen de regio. Geef je op met je groep,
						of kom kijken wat er speelt.
					</p>
				</div>
				<a href="/posts" class="btn btn-outline">
					Volledige kalender
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
				</a>
			</div>
			<div class="event-grid">
				<a class="event-card" href="/posts">
					<div class="event-date">
						<span class="d">14</span>
						<span class="m">Mei</span>
					</div>
					<div class="event-body">
						<span class="event-tag event-tag--regio">Alle groepen</span>
						<h4>Hemelvaartsontmoeting</h4>
						<div class="event-meta">
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
								Schoonhoven · Buitenterrein
							</span>
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
								09:30 – 17:00
							</span>
						</div>
					</div>
				</a>
				<a class="event-card" href="/posts">
					<div class="event-date">
						<span class="d">6</span>
						<span class="m">Jun</span>
					</div>
					<div class="event-body">
						<span class="event-tag event-tag--training">Vrijwilligers</span>
						<h4>Praktijkbegeleiderstraining</h4>
						<div class="event-meta">
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
								Scouting Academy · IJsselstein
							</span>
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
								19:30 – 22:00
							</span>
						</div>
					</div>
				</a>
				<a class="event-card" href="/posts">
					<div class="event-date">
						<span class="d">21</span>
						<span class="m">Jun</span>
					</div>
					<div class="event-body">
						<span class="event-tag event-tag--water">Watergroepen</span>
						<h4>Regio Waterspelen</h4>
						<div class="event-meta">
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
								Reeuwijkse Plassen
							</span>
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
								10:00 – 16:00
							</span>
						</div>
					</div>
				</a>
				<a class="event-card" href="/posts">
					<div class="event-date">
						<span class="d">5</span>
						<span class="m">Jul</span>
					</div>
					<div class="event-body">
						<span class="event-tag event-tag--land">Landgroepen</span>
						<h4>Zomerkamp opbouw — Landgroepen</h4>
						<div class="event-meta">
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
								Kampterrein Lopikerwaard
							</span>
							<span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
								Hele dag
							</span>
						</div>
					</div>
				</a>
			</div>
		</div>
	</section>

	<!-- ── Over de regio ─────────────────────────────────────────── -->
	<section class="section-regio">
		<div class="container">
			<div class="regio-grid">
				<div class="regio-text">
					<p class="eyebrow">Over de regio</p>
					<h2 class="section-title">16 groepen, één regio. Water én land.</h2>
					<p class="regio-lede">
						Scouting Regio Lek- en IJsselstreek ligt in het hart van Zuid-Holland,
						tussen de Lek en de Hollandse IJssel. Acht watergroepen, acht landgroepen —
						samen verzorgen we activiteiten, trainingen en ondersteuning voor alle
						vrijwilligers en jeugdleden.
					</p>
					<p class="regio-lede">
						Of je nu zelf wil scouten, je kind wil aanmelden, of jezelf wil ontwikkelen
						als vrijwilliger — bij ons ben je welkom. Neem een kijkje of stel een vraag.
					</p>
					<div class="regio-actions">
						<a href="/posts" class="btn btn-primary">
							Lees meer
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
						</a>
						<a href="/posts" class="btn btn-outline">Stel je vraag</a>
					</div>
				</div>
				<div class="stats-grid">
					<div class="stat-card">
						<b>16</b>
						<span>Scoutinggroepen</span>
					</div>
					<div class="stat-card">
						<b>1800</b>
						<span>Jeugdleden</span>
					</div>
					<div class="stat-card">
						<b>800</b>
						<span>Vrijwilligers</span>
					</div>
					<div class="stat-card">
						<b>50+</b>
						<span>Activiteiten per jaar</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Vacatures ─────────────────────────────────────────────── -->
	<section class="section-vacatures">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Vrijwilligers</p>
					<h2 class="section-title">Open vacatures in de regio</h2>
					<p class="section-lede">
						Op zoek naar een leuke plek voor jouw sterke punten? De regio heeft altijd
						ruimte voor enthousiaste mensen — bestuur, trainers, organisatie.
					</p>
				</div>
				<a href="/posts" class="btn btn-outline">
					Alle vacatures
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
				</a>
			</div>
			<div class="vacature-grid">
				<a class="vacature-card" href="/posts">
					<div class="vacature-header">
						<div class="vacature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/></svg>
						</div>
						<div>
							<div class="vacature-org">Regiobestuur</div>
							<div class="vacature-commit">4–6 uur per week</div>
						</div>
					</div>
					<h4 class="vacature-role">Bestuurslid Communicatie</h4>
					<p class="vacature-desc">Versterk het regiobestuur en geef richting aan de communicatie naar groepen, ouders en pers.</p>
					<span class="vacature-link">
						Lees meer
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</span>
				</a>
				<a class="vacature-card" href="/posts">
					<div class="vacature-header">
						<div class="vacature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11v5c2 2 10 2 12 0v-5M22 9v5"/></svg>
						</div>
						<div>
							<div class="vacature-org">Scouting Academy</div>
							<div class="vacature-commit">1 avond per maand</div>
						</div>
					</div>
					<h4 class="vacature-role">Trainer Scouting Academy</h4>
					<p class="vacature-desc">Begeleid (toekomstige) leiding tijdens trainingsavonden — van basisvaardigheden tot teamleiderschap.</p>
					<span class="vacature-link">
						Lees meer
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</span>
				</a>
				<a class="vacature-card" href="/posts">
					<div class="vacature-header">
						<div class="vacature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" aria-hidden="true"><path d="M3 21l9-16 9 16H3zM12 21V11"/></svg>
						</div>
						<div>
							<div class="vacature-org">Regiokamp 2026</div>
							<div class="vacature-commit">Projectmatig</div>
						</div>
					</div>
					<h4 class="vacature-role">Vrijwilliger Regiokampbouw</h4>
					<p class="vacature-desc">Help mee met de organisatie van het tweejaarlijkse regiokamp. Logistiek, programma of techniek.</p>
					<span class="vacature-link">
						Lees meer
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</span>
				</a>
			</div>
		</div>
	</section>

	<!-- ── Nieuws ─────────────────────────────────────────────────── -->
	<section class="section-nieuws" id="nieuws">
		<div class="container">
			<div class="section-head">
				<div>
					<p class="eyebrow">Nieuws</p>
					<h2 class="section-title">Laatste updates uit de regio</h2>
					<p class="section-lede">Wat gebeurt er bij de groepen, in het bestuur en op trainingen.</p>
				</div>
				<a href="/posts" class="btn btn-outline">
					Alle nieuws
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
				</a>
			</div>
			{postsWithTags.length > 0 ? (
				<div class="news-grid">
					{postsWithTags.map(({ post, tags }) => (
						<PostCard
							title={post.data.title ?? "Zonder titel"}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags}
						/>
					))}
				</div>
			) : (
				<p class="no-posts">Er zijn nog geen berichten gepubliceerd.</p>
			)}
		</div>
	</section>

	<!-- ── CTA banner ─────────────────────────────────────────────── -->
	<section class="section-cta">
		<div class="container">
			<div class="cta-banner">
				<div class="cta-text">
					<p class="eyebrow" style="color:rgba(255,255,255,.85)">Nieuw bij scouting?</p>
					<h2>Stap een keer binnen bij een groep.</h2>
					<p>Veel groepen organiseren een open opkomst — kom een avond meedraaien en
						zie of het iets voor je is. We helpen je graag de juiste groep vinden.</p>
				</div>
				<div class="cta-actions">
					<a href="/posts" class="btn btn-light">Bekijk het laatste nieuws</a>
					<a href="/posts" class="btn btn-ghost">Stel een vraag</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	/* ── Shared container ────────────────────────────────────────── */
	.container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 32px;
	}

	/* ── Section header ──────────────────────────────────────────── */
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 40px;
		flex-wrap: wrap;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: .08em;
		color: var(--color-primary-hover);
		margin: 0 0 12px;
	}

	.eyebrow::before {
		content: "";
		width: 24px;
		height: 2px;
		background: currentColor;
		display: inline-block;
	}

	.section-title {
		font-size: clamp(1.75rem, 2.6vw, 2.25rem);
		font-weight: 900;
		letter-spacing: -.015em;
		margin: 0 0 12px;
		color: var(--color-text);
	}

	.section-lede {
		font-size: 17px;
		color: var(--color-muted);
		max-width: 60ch;
		line-height: 1.65;
		margin: 0;
	}

	/* ── Buttons ─────────────────────────────────────────────────── */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 24px;
		border-radius: var(--radius-pill);
		font-weight: 800;
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: .06em;
		border: 2px solid transparent;
		cursor: pointer;
		font-family: inherit;
		text-decoration: none;
		transition: all var(--transition-base);
		white-space: nowrap;
	}

	.btn-primary {
		background: var(--color-primary);
		color: #fff;
		box-shadow: 0 8px 18px rgba(91,174,58,.25);
	}
	.btn-primary:hover { background: var(--color-primary-hover); transform: translateY(-1px); color: #fff; }

	.btn-light { background: #fff; color: var(--color-text); }
