---
import type { MediaValue, ContentBylineCredit } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags,
} = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("nl-NL", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
	: null;

const primaryTag = tags?.[0];
---

<a class="news-card" href={href}>
	<div class="card-image">
		{
			featuredImage ? (
				<Image image={featuredImage} />
			) : (
				<div class="card-placeholder" aria-hidden="true">
					<svg viewBox="0 0 320 200" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
						<rect width="320" height="200" fill="#DCEFE5"/>
						<circle cx="100" cy="110" r="46" fill="#5BAE3A" opacity=".22"/>
						<circle cx="220" cy="80" r="32" fill="#5BAE3A" opacity=".28"/>
					</svg>
				</div>
			)
		}
	</div>
	<div class="card-body">
		{primaryTag && (
			<span class="card-cat">{primaryTag.label}</span>
		)}
		<h3 class="card-title">{title}</h3>
		{excerpt && <p class="card-excerpt">{excerpt}</p>}
		<div class="card-meta">
			{formattedDate && <span>{formattedDate}</span>}
			{formattedDate && readingTime && <span class="meta-sep">·</span>}
			{readingTime && <span>{readingTime} min leestijd</span>}
		</div>
	</div>
</a>

<style>
	.news-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition: transform var(--transition-base), box-shadow var(--transition-base);
	}

	.news-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-card-hover);
		text-decoration: none;
	}

	.card-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--color-surface);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.news-card:hover .card-image img { transform: scale(1.04); }

	.card-placeholder {
		width: 100%;
		height: 100%;
	}

	.card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		padding: 20px 22px 18px;
	}

	.card-cat {
		display: inline-block;
		font-size: 11px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: .08em;
		color: var(--color-primary-hover);
		margin-bottom: 8px;
	}

	.card-title {
		font-size: var(--font-size-lg);
		font-weight: 800;
		line-height: var(--leading-snug);
		margin-bottom: 8px;
		color: var(--color-text);
		transition: color var(--transition-fast);
	}

	.news-card:hover .card-title { color: var(--color-primary); }

	.card-excerpt {
		font-size: var(--font-size-sm);
		line-height: 1.6;
		color: var(--color-muted);
		margin-bottom: 14px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-top: auto;
	}

	.meta-sep { opacity: .6; }
</style>
